{
  "name": "dsh-rss-news-flash-kuaixun",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "dsh companion plugin: real-time flash news adapters — 财联社电报/金十/华尔街见闻/东方财富/同花顺/新浪财经 7×24.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terry2010/dsh-rss-news-flash-kuaixun.git"
  },
  "homepage": "https://github.com/terry2010/dsh-rss-news-flash-kuaixun#readme",
  "bugs": "https://github.com/terry2010/dsh-rss-news-flash-kuaixun/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "news",
    "flash-news",
    "kuaixun",
    "finance",
    "stock-news",
    "ticker",
    "rss",
    "real-time"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "dsh-rss-news-daily": "^1.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/node": "^22.0.0",
    "dsh-rss-news-daily": "file:../dsh-rss-news-daily",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  }
}
